{
  "id": "./index.html",
  "name": "Bookkeeping Ledger - Expense & Bookkeeping",
  "short_name": "Ledger",
  "description": "Multi-user bilingual daily income, expense, budget, analytics, and Ethiopian calendar bookkeeping app with cross-device cloud sync and email OTP verification.",
  "start_url": "./index.html",
  "scope": "./",
  "lang": "en",
  "dir": "ltr",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#f4f6f9",
  "theme_color": "#183e8a",
  "categories": [
    "finance",
    "business",
    "productivity"
  ],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "./screenshot-mobile.png",
      "sizes": "540x720",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Bookkeeping Ledger Records & Balance View"
    },
    {
      "src": "./screenshot-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Bookkeeping Ledger Desktop & Tablet View"
    }
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "shortcuts": [
    {
      "name": "Records",
      "short_name": "Records",
      "description": "View balance and recent records",
      "url": "./index.html#records",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Report",
      "short_name": "Report",
      "description": "View spending analytics and charts",
      "url": "./index.html#report",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Add Record",
      "short_name": "Add",
      "description": "Add a new income or expense record",
      "url": "./index.html?action=new",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "name": "Bookkeeping Ledger data",
      "accept": {
        "text/csv": [
          ".csv"
        ],
        "application/json": [
          ".json"
        ]
      },
      "launch_type": "single-client"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+galmee",
      "url": "./index.html?entry=%s"
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "note_taking": {
    "new_note_url": "./index.html?action=new"
  },
  "widgets": [
    {
      "name": "Balance",
      "short_name": "Balance",
      "description": "Total balance with income and expense summary",
      "tag": "galmee-balance",
      "template": "galmee-balance",
      "ms_ac_template": "./widgets/balance-template.json",
      "data": "./widgets/balance-data.json",
      "type": "application/json",
      "auth": false,
      "update": 3600,
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192"
        }
      ],
      "screenshots": [
        {
          "src": "./screenshot-mobile.png",
          "sizes": "540x720",
          "label": "Balance widget"
        }
      ]
    }
  ]
}