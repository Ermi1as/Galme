{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    { "type": "TextBlock", "text": "Total Balance", "size": "Small", "isSubtle": true },
    { "type": "TextBlock", "text": "${balance}", "size": "ExtraLarge", "weight": "Bolder", "wrap": true },
    {
      "type": "ColumnSet",
      "columns": [
        { "type": "Column", "width": "stretch", "items": [
          { "type": "TextBlock", "text": "Income", "size": "Small", "isSubtle": true },
          { "type": "TextBlock", "text": "${income}", "color": "Good", "weight": "Bolder" } ] },
        { "type": "Column", "width": "stretch", "items": [
          { "type": "TextBlock", "text": "Expense", "size": "Small", "isSubtle": true },
          { "type": "TextBlock", "text": "${expense}", "color": "Attention", "weight": "Bolder" } ] }
      ]
    }
  ],
  "actions": [ { "type": "Action.Execute", "title": "Add record", "verb": "add" } ]
}
